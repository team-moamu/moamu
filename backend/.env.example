# Database
# Match the port published by your local Docker container (for example, 3307).
DB_URL=jdbc:mysql://127.0.0.1:3306/moamu
DB_USERNAME=moamu
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=

# JWT
JWT_SECRET=

# AI Server
AI_SERVER_URL=http://localhost:8000
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=30s

# Testcontainers (same version as the team's development DB)
TEST_MYSQL_IMAGE=mysql:8.4.11

# AWS S3
S3_BUCKET=
AWS_REGION=
S3_ARTWORK_PREFIX=artworks/
S3_PROFILE_PREFIX=profiles/
S3_VERIFICATION_PREFIX=verifications/

# AWS 접근 인증
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=